{
  "name": "loongcode-promo-video",
  "version": "1.0.0",
  "private": true,
  "description": "LoongCode 暗黑鎏金风竖屏宣传片（Remotion）",
  "scripts": {
    "preview": "remotion studio",
    "render": "remotion render LoongCodePromo out/loongcode-promo.mp4 --codec=h264",
